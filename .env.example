# Settings for the plain HTTP stack (docker-compose.yml).
# Copy to .env and adjust; docker compose reads it automatically. For HTTPS, start from
# .env.https.example instead.

# Host port the app is published on. The UI lives at http://<host>:<PORT>/
PORT=7860

# Extra webui flags, appended to "--listen --port 7860 --api --data-dir /data".
COMMANDLINE_ARGS=
# e.g. COMMANDLINE_ARGS=--xformers --medvram
# e.g. COMMANDLINE_ARGS=--gradio-auth user:password --api-auth user:password
# --enable-insecure-extension-access allows installing extensions from the UI, which is
# off by default when the webui listens on the network.

# Optional Hugging Face token for faster, rate-limit-free downloads.
HF_TOKEN=
