# Settings for the plain HTTP stack (docker-compose.yml).
# Copy to .env and adjust; docker compose reads it automatically. For HTTPS, start from
# .env.https.example instead.

# Host port the app is published on. The UI lives at http://<host>:<PORT>/
PORT=7860

# Extra webui flags, appended to "--listen --port 7860 --api --data-dir /data".
# The default suits an RTX 3090 (or any 24 GB Ampere/Ada card): xformers attention (installed
# into the venv volume on first start, which needs network access) and no VRAM-saving flags,
# which only slow things down with 24 GB. --gradio-auth guards the UI and --api-auth the API;
# change the username and password before exposing the app.
COMMANDLINE_ARGS=--xformers --gradio-auth admin:changeme --api-auth admin:changeme
# e.g. COMMANDLINE_ARGS=--opt-sdp-attention ...   PyTorch's attention instead of xformers
# e.g. COMMANDLINE_ARGS=--xformers --medvram ...  for cards with 8 GB or less
# --enable-insecure-extension-access allows installing extensions from the UI, which is
# off by default when the webui listens on the network.

# Optional Hugging Face token for faster, rate-limit-free downloads.
HF_TOKEN=
